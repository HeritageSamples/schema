CORDRA_REST_API_URL=https://cordra.heritagesamples.org
CORDRA_ADMIN_USERNAME=admin
CORDRA_ADMIN_PASSWORD=***
# CORDRA_HDL_PREFIX is not used by delete.py / export.py / import.py
CORDRA_HDL_PREFIX=20.18.1001

# Optional: default protocol and TLS verification (delete.py / export.py / import.py)
# CORDRA_PROTOCOL=rest
# CORDRA_VERIFY_TLS=false

# Optional: Cordra DoIP client settings (only needed for --protocol doip)
# CORDRA_DOIP_HOST=
# CORDRA_DOIP_PORT=9001
# CORDRA_DOIP_SERVICE_ID=HSR/service

# Optional: harvest and upload tuning
# CORDRA_DEFAULT_BATCH_SIZE=250
# CORDRA_PUBLIC_WRITER_GROUP=auth.powerusers
