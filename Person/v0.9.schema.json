{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://heritagesamples.org/schema/Person/v0.9",
    "title": "Person",
    "type": "object",
    "required": [
        "firstName",
        "lastName"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "options": {
                "hidden": true
            }
        },
        "id": {
            "type": "string",
            "cordra": {
                "type": {
                    "autoGeneratedField": "handle"
                }
            }
        },
        "title": {
            "title": "Title",
            "description": "Personal title",
            "type": "string",
            "cordra": {
                "type": {
                    "handleReference": {
                        "types": [
                            "VocabularyConcept"
                        ],
                        "filters": [
                            "/queryTerms/_:\"Person-personalTitle\""
                        ]
                    }
                }
            }
        },
        "names": {
            "title": "Names of the person",
            "description": "Names of the person, used to identify the person in different contexts. Different names and languages can be added here. The first name with a certain language will be used as the primary name of the person in that language.",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "title": "First name",
                        "description": "First name",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 128
                    },
                    "lastName": {
                        "title": "Last name",
                        "description": "Last name",
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 128
                    },
                    "lang": {
                        "type": "string",
                        "cordra": {
                            "type": {
                                "handleReference": {
                                    "types": ["VocabularyConcept"],
                                    "filters": ["/queryTerms/_:\"Common-language\""]
                                }
                            }
                        }
                    }
                }
            }
        },
        "externalPids": {
            "title": "External PIDs",
            "description": "External PIDs",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "pidType",
                    "pid"
                ],
                "properties": {
                    "pidType": {
                        "type": "string",
                        "cordra": {
                            "type": {
                                "handleReference": {
                                    "types": [
                                        "VocabularyConcept"
                                    ],
                                    "filters": [
                                        "/queryTerms/_:\"Common-persistentIdentifier\""
                                    ]
                                }
                            }
                        },
                        "default": "HSR/voc.hsr.orcid"
                    },
                    "pid": {
                        "title": "PID",
                        "description": "PID",
                        "type": "string",
                        "format": "uri"
                    }
                }
            }
        },
        "partOfOrganisation": {
            "title": "Affiliations",
            "description": "Affiliations",
            "type": "array",
            "items": {
                "title": "Organisation",
                "description": "Reference to the Organisation",
                "type": "string",
                "cordra": {
                    "type": {
                        "handleReference": {
                            "types": [
                                "Organisation"
                            ]
                        }
                    }
                }
            }
        },
        "mbox": {
            "title": "Email",
            "description": "Contact email address (professional)",
            "type": "string",
            "format": "email"
        },
        "phone": {
            "title": "Phone",
            "description": "Contact phone number (professional)",
            "type": "string",
            "format": "tel"
        },
        "webpage": {
            "title": "Webpage",
            "description": "Webpage(s) related to the person (e.g. personal webpage, profile page on the institutional website, etc.)",
            "type": "array",
            "items": {
                "title": "URL",
                "description": "URL",
                "type": "string",
                "format": "uri"
            }
        }
    }
}
