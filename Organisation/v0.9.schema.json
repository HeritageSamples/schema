{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://heritagesamples.org/schema/Organisation/v0.9",
    "title": "Organisation",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "options": {
                "hidden": true
            }
        },
        "id": {
            "type": "string",
            "cordra": {
                "type": {
                    "autoGeneratedField": "handle"
                }
            }
        },
        "acronym": {
            "title": "Acronym",
            "description": "Acronym",
            "type": "string"
        },
        "names": {
            "title": "Names of the organisation",
            "description": "Names of the organisation, used to identify the organisation in different contexts. Different names and languages can be added here. The first name with a certain language will be used as the primary name of the organisation in that language.",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "title": "Name",
                        "description": "Name of the organisation",
                        "type": "string"
                    },
                    "lang": {
                        "type": "string",
                        "cordra": {
                            "type": {
                                "handleReference": {
                                    "types": ["VocabularyConcept"],
                                    "filters": ["/queryTerms/_:\"Common-language\""]
                                }
                            }
                        }
                    }
                }
            }
        },
        "externalPids": {
            "title": "External PIDs",
            "description": "External PIDs",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "pidType",
                    "pid"
                ],
                "properties": {
                    "pidType": {
                        "type": "string",
                        "cordra": {
                            "type": {
                                "handleReference": {
                                    "types": [
                                        "VocabularyConcept"
                                    ],
                                    "filters": [
                                        "/queryTerms/_:\"Common-persistentIdentifier\""
                                    ]
                                }
                            }
                        }
                    },
                    "pid": {
                        "title": "PID",
                        "description": "PID",
                        "type": "string",
                        "format": "uri"
                    }
                }
            }
        },
        "organisationType": {
            "title": "Organisation type",
            "description": "Type or legal status of the organisation. This dropdown list gives a few examples, but if required, you can enter a different value here.",
            "type": "array",
            "items": {
                "type": "string",
                "cordra": {
                    "type": {
                        "handleReference": {
                            "types": [
                                "VocabularyConcept"
                            ],
                            "filters": [
                                "/queryTerms/_:\"Organisation-organisationType\""
                            ]
                        }
                    }
                }
            }
        },
        "partOfOrganisation": {
            "title": "Parent organisations",
            "description": "Parent organisations",
            "type": "array",
            "items": {
                "title": "Organisation",
                "description": "Reference to an organisation",
                "type": "string",
                "cordra": {
                    "type": {
                        "handleReference": {
                            "types": [
                                "Organisation"
                            ]
                        }
                    }
                }
            }
        },
        "mbox": {
            "title": "Email",
            "description": "Contact email address of the organisation (not personal email addresses)",
            "type": "string",
            "format": "email"
        },
        "phone": {
            "title": "Phone",
            "description": "Contact phone number of the organisation (not personal phone numbers)",
            "type": "string",
            "format": "tel"
        },
        "webpages": {
            "title": "Webpages",
            "description": "Webpage(s) of the organisation",
            "type": "array",
            "items": {
                "title": "URL",
                "description": "URL",
                "type": "string",
                "format": "uri"
            }
        }
    }
}
