{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://heritagesamples.org/schema/community/v0.9.schema.json",
    "title": "Community",
    "type": "object",
    "required": [
        "id",
        "titles",
        "igsnPrefix"
    ],
    "properties": {
        "id": {
            "type": "string",
            "cordra": {
                "type": {
                    "autoGeneratedField": "handle"
                }
            }
        },
        "titles": {
            "type": "array",
            "title": "Alternative community names or labels",
            "description": "Alternative names, codes or labels assigned by the organisation responsible for the community.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "title": "Title",
                        "description": "The title of the community.",
                        "type": "string",
                        "cordra": {
                            "preview": {
                                "showInPreview": true
                            }
                        }
                    },
                    "lang": {
                        "title": "Language",
                        "description": "The language of the title.",
                        "type": "string",
                        "cordra": {
                            "type": {
                                "handleReference": {
                                    "types": ["VocabularyConcept"],
                                    "filters": ["/queryTerms/_:\"Common-language\""]
                                }
                            }
                        }
                    }
                },
                "hidden": true
            }
        },
        "igsnPrefix": {
            "type": "string",
            "title": "IGSN Prefix",
            "description": "The IGSN prefix used for the community.",
            "format": "uri"
        },
        "_displayTitle": {
            "type": "string",
            "title": "Display Title",
            "description": "The display title of the community.",
            "readOnly": true
        }
    },
    "additionalProperties": false
}